DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
# 默认使用本地 MySQL；启动时自动创建库和表
CHAT_DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=deepseek_chat
# 仅切回 SQLite 时使用：CHAT_DB_BACKEND=sqlite
# CHAT_DB_PATH=data/chat.sqlite3
